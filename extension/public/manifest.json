{
  "manifest_version": 3,
  "name": "The Key (Standard of Taste)",
  "short_name": "The Key",
  "description": "Words about your own taste that you can check. Everything stays in this browser.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Open The Key",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bilibili.com/video/*", "https://www.bilibili.com/*/video/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["sidePanel"],
  "host_permissions": ["https://musicbrainz.org/*", "https://acousticbrainz.org/*", "https://www.wikidata.org/*"]
}
